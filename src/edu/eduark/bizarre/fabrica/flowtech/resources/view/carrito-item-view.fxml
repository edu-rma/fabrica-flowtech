<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox spacing="8.0" alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.eduark.bizarre.fabrica.flowtech.controller.CarritoItemController">
    <children>
        <Label fx:id="lblNombre" wrapText="true" prefWidth="230.0" />
        <Button fx:id="btnMenos" text="−" onAction="#restar" />
        <Label fx:id="lblCantidad" minWidth="24.0" alignment="CENTER" />
        <Button fx:id="btnMas" text="+" onAction="#sumar" />
        <Button fx:id="btnEliminar" styleClass="remove-cart-button" text="Eliminar" onAction="#eliminar" />
    </children>
</HBox>
