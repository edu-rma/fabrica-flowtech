<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="edu.eduark.bizarre.fabrica.flowtech.controller.LoginController">
    <stylesheets>
        <URL value="@../style/css/login-view.fxml.css" />
    </stylesheets>
   <children>
      <VBox alignment="CENTER" layoutX="150.0" layoutY="50.0" prefHeight="300.0" prefWidth="300.0" spacing="15.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="50.0">
         <children>
            <Label styleClass="title-label" text="FlowTech - Login" />
            <TextField fx:id="txtCorreo" promptText="Correo electrónico" />
            <PasswordField fx:id="txtContrasena" promptText="Contraseña" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnIniciarSesion" defaultButton="true" mnemonicParsing="false" text="Iniciar Sesión" />
                  <Button fx:id="btnRegistrarse" mnemonicParsing="false" text="Registrarse" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>