<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../style/css/dashboar-view.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.eduark.bizarre.fabrica.flowtech.controller.ClienteDashboardController">
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="8.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="sidebar-title" text="FlowTech" />
            <Label fx:id="lblUsuario" styleClass="sidebar-user" text="Usuario" />
            
            <Label fx:id="lblRol" styleClass="sidebar-rol" text="Cliente" />
            
            <Separator />
            <Button fx:id="btnInicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarInicio" styleClass="menu-button" text="Inicio" />
            <Button fx:id="btnMisPedidos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarMisPedidos" styleClass="menu-button" text="Mis Pedidos" />
            <Button fx:id="btnCatalogo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarCatalogo" styleClass="menu-button" text="Catálogo" />
            <Button fx:id="btnPerfil" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarPerfil" styleClass="menu-button" text="Mi Perfil" />
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cerrarSesion" styleClass="menu-button-salir" text="Cerrar sesión" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblContenidoActual" styleClass="content-label" text="Cargando..." wrapText="true" />
         </children>
      </StackPane>
   </center>
</BorderPane>