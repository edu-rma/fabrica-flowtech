<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.eduark.bizarre.fabrica.flowtech.controller.ClientePerfilController">
    <content>
        <VBox spacing="16.0" styleClass="page-content">
            <padding>
                <Insets top="26.0" right="26.0" bottom="26.0" left="26.0" />
            </padding>
            <children>
                <Label styleClass="page-title" text="Mi perfil" />
                <Label fx:id="lblUsuario" text="Cliente" />

                <VBox styleClass="card" spacing="10.0">
                    <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                    </padding>
                    <children>
                        <Label styleClass="page-title" text="Metodos de pago guardados" />
                        <Label fx:id="lblMetodoPreferido" text="Sin metodos guardados" />
                        <Button text="Administrar metodos" onAction="#administrarMetodos" />
                    </children>
                </VBox>

                <VBox styleClass="card" spacing="10.0">
                    <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                    </padding>
                    <children>
                        <Label styleClass="page-title" text="Preferencias de notificacion" />
                        <CheckBox fx:id="chkCorreo" text="Alertas sobre pedidos por correo" onAction="#cambiarNotificarCorreo" />
                        <CheckBox fx:id="chkSms" text="Alertas sobre pedidos por SMS" onAction="#cambiarNotificarSms" />
                        <Label fx:id="lblEstadoPreferencias" styleClass="cart-summary" text="" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
