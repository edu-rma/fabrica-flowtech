<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.eduark.bizarre.fabrica.flowtech.controller.cliente.ClientePerfilController">
    <content>
        <VBox spacing="16.0" styleClass="page-content">
            <padding>
                <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
            </padding>
            <children>
                <Label styleClass="page-title" text="Mi perfil" />
                <Label fx:id="lblUsuario" text="Cliente" />

                <VBox spacing="10.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <children>
                        <Label styleClass="page-title" text="Metodos de pago guardados" />
                        <Label fx:id="lblMetodoPreferido" text="No tienes métodos de pago seleccionados" />
                        <Button onAction="#administrarMetodos" text="Administrar métodos" />
                    </children>
                </VBox>

                <VBox spacing="10.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <children>
                        <Label styleClass="page-title" text="Preferencias de notificacion" />
                        <CheckBox fx:id="chkCorreo" onAction="#cambiarNotificarCorreo" text="Alertas sobre pedidos por correo" />
                        <CheckBox fx:id="chkSms" onAction="#cambiarNotificarSms" text="Quiero recibir notificaciones por correo electrónico" />
                        <Label fx:id="lblEstadoPreferencias" styleClass="cart-summary" text="" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
