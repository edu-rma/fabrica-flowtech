<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1150.0" stylesheets="@../style/css/flowtech-theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.eduark.bizarre.fabrica.flowtech.controller.dashboard.DashboardAdminController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
         <children>
            <VBox spacing="3.0"><children><Label styleClass="app-name" text="FLOWTECH" /><Label styleClass="topbar-subtitle" text="Panel de administración" /></children></VBox>
            <HBox HBox.hgrow="ALWAYS" />
            <Label styleClass="user-chip" text="Administrador" />
            <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" styleClass="menu-button-salir" text="Cerrar sesión" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="18.0" styleClass="page-content">
         <children>
            <VBox spacing="4.0"><children><Label styleClass="page-title" text="Control administrativo" /><Label styleClass="page-subtitle" text="Gestiona inventario, pedidos y empleados desde un solo lugar." /></children></VBox>
            <HBox spacing="16.0">
               <children>
                  <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><children><Label styleClass="metric-label" text="PRODUCTOS REGISTRADOS" /><Label fx:id="lblProductos" styleClass="metric-value" text="0" /></children></VBox>
                  <VBox styleClass="metric-card metric-danger" HBox.hgrow="ALWAYS"><children><Label styleClass="metric-label" text="ALERTAS DE STOCK" /><Label fx:id="lblAlertas" styleClass="metric-value" text="0" /></children></VBox>
                  <VBox styleClass="metric-card metric-blue" HBox.hgrow="ALWAYS"><children><Label styleClass="metric-label" text="PEDIDOS EN PRODUCCIÓN" /><Label fx:id="lblPedidosProceso" styleClass="metric-value" text="0" /></children></VBox>
               </children>
            </HBox>
            <TabPane fx:id="tabsAdmin" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab text="Inventario">
                     <content>
                        <VBox spacing="14.0" styleClass="table-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="section-title" text="Inventario de productos" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <ComboBox fx:id="cmbFiltro" prefWidth="145.0" />
                                    <TextField fx:id="txtBuscar" prefWidth="220.0" promptText="Buscar por SKU o producto" />
                                    <Button fx:id="btnAgregarInventario" onAction="#agregarInventario" styleClass="quick-action" text="+ Agregar" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tablaInventario" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colSku" prefWidth="120.0" text="SKU" />
                                    <TableColumn fx:id="colProducto" prefWidth="300.0" text="PRODUCTO" />
                                    <TableColumn fx:id="colStock" prefWidth="110.0" text="STOCK ACTUAL" />
                                    <TableColumn fx:id="colMinimo" prefWidth="110.0" text="STOCK MÍNIMO" />
                                    <TableColumn fx:id="colEstado" prefWidth="130.0" text="ESTADO" />
                                    <TableColumn fx:id="colAccionesInventario" prefWidth="170.0" text="ACCIONES" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding><Insets bottom="20.0" left="4.0" right="4.0" top="4.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>
                  <Tab text="Pedidos">
                     <content>
                        <VBox spacing="14.0" styleClass="table-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="section-title" text="Pedidos" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <ComboBox fx:id="cmbFiltroPedidos" prefWidth="165.0" />
                                    <TextField fx:id="txtBuscarPedidos" prefWidth="200.0" promptText="Buscar por cliente o #ID" />
                                    <Button fx:id="btnNuevoPedido" onAction="#agregarPedido" styleClass="quick-action" text="+ Nuevo pedido" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tablaPedidos" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colIdPedido" prefWidth="70.0" text="ID" />
                                    <TableColumn fx:id="colCliente" prefWidth="170.0" text="CLIENTE" />
                                    <TableColumn fx:id="colEmpleado" prefWidth="170.0" text="EMPLEADO" />
                                    <TableColumn fx:id="colFechaPedido" prefWidth="140.0" text="FECHA" />
                                    <TableColumn fx:id="colEstadoPedido" prefWidth="130.0" text="ESTADO" />
                                    <TableColumn fx:id="colTotalPedido" prefWidth="100.0" text="TOTAL" />
                                    <TableColumn fx:id="colAccionesPedido" prefWidth="210.0" text="ACCIONES" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding><Insets bottom="20.0" left="4.0" right="4.0" top="4.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>
                  <Tab text="Empleados">
                     <content>
                        <VBox spacing="14.0" styleClass="table-card">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="section-title" text="Empleados" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtBuscarEmpleados" prefWidth="240.0" promptText="Buscar por nombre o correo" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colIdEmpleado" prefWidth="60.0" text="ID" />
                                    <TableColumn fx:id="colNombreEmpleado" prefWidth="220.0" text="NOMBRE" />
                                    <TableColumn fx:id="colEmailEmpleado" prefWidth="230.0" text="CORREO" />
                                    <TableColumn fx:id="colEstadoEmpleado" prefWidth="110.0" text="ESTADO" />
                                    <TableColumn fx:id="colFechaEmpleado" prefWidth="130.0" text="INGRESO" />
                                    <TableColumn fx:id="colAccionesEmpleado" prefWidth="140.0" text="ACCIONES" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding><Insets bottom="20.0" left="4.0" right="4.0" top="4.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
         <padding><Insets bottom="24.0" left="36.0" right="36.0" top="24.0" /></padding>
      </VBox>
   </center>
</BorderPane>
